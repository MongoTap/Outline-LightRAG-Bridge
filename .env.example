# LightRAG API 地址
LIGHTRAG_API_URL=http://localhost:9621

# Outline Webhook Secret（在 Outline 管理后台配置 Webhook 时设置的密钥）
OUTLINE_WEBHOOK_SECRET=your_webhook_secret_here

# 桥接服务监听配置
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=9641

# LightRAG 处理状态轮询配置
POLL_INTERVAL=2
POLL_MAX_ATTEMPTS=60

# 删除操作重试配置
DELETE_RETRY_ATTEMPTS=3
DELETE_RETRY_DELAY=5

# 夜间定时批量处理窗口（可选，默认关闭=实时处理）
# 开启后，任务仅在每日窗口内处理，白天只入队不处理，充分利用夜间闲置算力
TASK_SCHEDULE_ENABLED=false
TASK_SCHEDULE_START=00:00
TASK_SCHEDULE_DURATION_MINUTES=480

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
