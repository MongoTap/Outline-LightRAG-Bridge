# LightRAG API 地址
LIGHTRAG_API_URL=http://localhost:9621

# Outline Webhook Secret（在 Outline 管理后台配置 Webhook 时设置的密钥）
OUTLINE_WEBHOOK_SECRET=your_webhook_secret_here

# 桥接服务监听配置
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=9641

# LightRAG 处理状态轮询配置
POLL_INTERVAL=2
POLL_MAX_ATTEMPTS=60

# 删除操作重试配置
DELETE_RETRY_ATTEMPTS=3
DELETE_RETRY_DELAY=5

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
